pipeline {
    agent { label 'reimage' }

    environment {
        VENV_DIR    = ".venv"
        REPO_DIR    = "${WORKSPACE}/Jenkins-job/preprod-jenkins"
        VENV_PATH   = "${REPO_DIR}/${VENV_DIR}"
        WORK_DIR    = "${WORKSPACE}/ci-work"
        DOMAIN      = "front.sepia.ceph.com"
        PROTECTED_LABELS_FILE = "${REPO_DIR}/protected_labels.txt"
    }

    parameters {
        booleanParam(name: 'SKIP_REIMAGE', defaultValue: false, description: 'Skip reimage stage and run only post-reimage tasks')
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Discover & print target nodes but do NOT mark offline or run reimage/tasks')
        choice(name: 'ACTION', choices: ['reimage','reimage-all','wait_online','discover'], description: 'Action to perform')
        string(name: 'MACHINE', defaultValue: '', description: 'Machine shortname or comma-separated list (e.g. irvingi08 or irvingi04,irvingi05)')
        string(name: 'OS', defaultValue: '', description: 'OS to deploy (optional). Example: jammy, focal')
    }

    stages {

        /* ---------------------------------------------------------------------
           Stage 1: Setup Python Virtual Environment (unchanged)
        --------------------------------------------------------------------- */
        stage('Setup Python Virtual Environment') {
            steps {
                withCredentials([string(credentialsId: 'maas-api-key', variable: 'MAAS_API_KEY')]) {
                    sh '''#!/bin/bash
                        set -euo pipefail
                        cd "$REPO_DIR"

                        if [ -d "$VENV_PATH" ]; then
                            echo "Removing incompatible virtual environment..."
                            rm -rf "$VENV_PATH"
                        fi

                        python3 -m venv "$VENV_PATH"
                        source "$VENV_PATH/bin/activate"

                        pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
            }
        }

        /* ---------------------------------------------------------------------
           Stage 2: Determine target nodes (single / multi / discover)
           Produces a Groovy list `targetNodesList` available to later stages.
        --------------------------------------------------------------------- */
        stage('Determine Target Nodes') {
            steps {
                script {
                    // Try loading protected labels from file
                    def protectedLabels = []
                    def file = new File(env.PROTECTED_LABELS_FILE)

                    if (file.exists()) {
                        echo "Loading protected labels from file: ${file}"
                        protectedLabels = file.readLines()
                                             .collect { it.trim() }
                                             .findAll { it && !it.startsWith('#') }
                    } else {
                        echo "protected_labels.txt not found. Using defaults."
                        protectedLabels = ["master", "teuthology", "libvirt", "mira", "www", "ec2"]
                    }

                    echo "Protected labels: ${protectedLabels.join(', ')}"

                    // Helper: parse MACHINE param into list
                    def parseMachineParam = { String m ->
                        if (!m?.trim()) return []
                        return m.split(',').collect { it.trim() }.findAll { it }
                    }

                    def candidates = []

                    if (params.ACTION == 'discover') {
                        echo "ACTION=discover: Discovering eligible nodes..."

                        def jenkins = Jenkins.instance
                        jenkins.nodes.each { node ->
                            def comp = node.computer
                            def nodeName = node.name
                            def labels = node.getAssignedLabels()*.name

                            // Skip protected-label nodes
                            if (protectedLabels.any { labels.contains(it) }) {
                                echo "Skipping protected ${nodeName}"
                                return
                            }

                            // If node offline -> include
                            if (comp?.offline) {
                                echo "${nodeName} is OFFLINE -> eligible"
                                candidates << nodeName
                                return
                            }

                            // Check if fully idle
                            def isIdle = (comp.countBusy() == 0)
                            def hasQueued = jenkins.queue.items.any { item ->
                                try {
                                    (item.assignedLabel != null) &&
                                    node.getAssignedLabels().any { it.name == item.assignedLabel.name }
                                } catch (ignored) { false }
                            }

                            if (isIdle && !hasQueued) {
                                echo "${nodeName} ONLINE + IDLE -> eligible"
                                candidates << nodeName
                            } else {
                                echo "${nodeName} busy/queued -> skip"
                            }
                        }

                    } else {
                        // Normal single/multi mode
                        def parsed = parseMachineParam(params.MACHINE)
                        if (parsed.isEmpty()) {
                            error "MACHINE parameter required unless ACTION=discover"
                        }
                        candidates = parsed
                    }

                    if (candidates.isEmpty()) {
                        error "No eligible nodes found!"
                    }

                    env.TARGET_NODES = candidates.join(',')
                    echo "Final target nodes: ${env.TARGET_NODES}"

                    // If DRY_RUN → stop now
                    if (params.DRY_RUN) {
                        echo ""
                        echo "========================"
                        echo "   DRY RUN - NO ACTION  "
                        echo "========================"
                        echo "Nodes that WOULD be reimaged:"
                        candidates.each { echo "  - $it" }
                        echo ""
                        echo "Stopping pipeline because DRY_RUN=true"
                        currentBuild.result = 'SUCCESS'
                        // Stop execution here
                        error("DRY_RUN complete - no further stages executed")
                    }
                }
            }
        }

        /* ---------------------------------------------------------------------
           Stage 3: Process Target Nodes (parallel) — unchanged logic except protected labels loaded earlier
        --------------------------------------------------------------------- */
        stage('Process Target Nodes (parallel)') {
            steps {
                script {
                    def nodeNames = env.TARGET_NODES.split(',').collect { it.trim() }.findAll { it }
                    if (!nodeNames) error "No nodes to process"

                    def branches = [:]

                    nodeNames.each { shortName ->
                        def n = shortName
                        branches["${n}"] = {
                            node('reimage') {
                                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                                    script {
                                        echo "=== Processing node: ${n} ==="

                                        // Mark temporarily offline if online (same logic as earlier)
                                        try {
                                            def nodeObj = Jenkins.instance.getNode(n)
                                            def comp = nodeObj?.toComputer()

                                            if (comp && !comp.offline) {
                                                def msg = "Marked for scheduled reimage via Jenkins automation pipeline"
                                                try {
                                                    comp.doChangeOfflineCause(msg)
                                                } catch (ignored) {
                                                    comp?.setTemporarilyOffline(true)
                                                }
                                                echo "[${n}] Marked temporarily offline"
                                            } else {
                                                echo "[${n}] Already offline"
                                            }
                                        } catch (e) {
                                            echo "[${n}] WARNING: Unable to mark offline: ${e}"
                                        }

                                        // === Reimage ===
                                        if (!params.SKIP_REIMAGE) {
                                            echo "[${n}] Starting reimage"
                                            withCredentials([string(credentialsId: 'maas-api-key', variable: 'MAAS_API_KEY')]) {
                                                sh """#!/bin/bash
                                                    set -euo pipefail
                                                    cd "$REPO_DIR"
                                                    source "$VENV_PATH/bin/activate"

                                                    MACHINE="${n}"
                                                    OS="\${OS:-}"

                                                    CMD="python Jenkins_builder-reimage.py --action reimage --machine ${n}"
                                                    if [ -n "${OS}" ]; then CMD="\$CMD --os ${OS}"; fi

                                                    echo "\$CMD"
                                                    eval \$CMD
                                                """
                                            }
                                        }

                                        // === Wait ready ===
                                        if (!params.SKIP_REIMAGE) {
                                            echo "[${n}] Waiting for deployed/ready"
                                            withCredentials([string(credentialsId: 'maas-api-key', variable: 'MAAS_API_KEY')]) {
                                                sh """#!/bin/bash
                                                    set -euo pipefail
                                                    cd "$REPO_DIR"
                                                    source "$VENV_PATH/bin/activate"
                                                    python Jenkins_builder-reimage.py --action wait_online --machine ${n}
                                                """
                                            }
                                        }

                                        // === Post Reimage ===
                                        echo "[${n}] Running post-reimage tasks"
                                        withCredentials([
                                            string(credentialsId: 'builder-api-token', variable: 'BUILDER_TOKEN'),
                                            string(credentialsId: 'ansible-vault-pass', variable: 'VAULT_PASS'),
                                            sshUserPrivateKey(credentialsId: 'ansible-ssh-key', keyFileVariable: 'SSH_KEY')
                                        ]) {
                                            sh """#!/bin/bash
                                                set -euo pipefail

                                                TARGET_FQDN="${n}.${DOMAIN}"

                                                mkdir -p "${WORK_DIR}"
                                                cp "${SSH_KEY}" /tmp/jenkins_git_key
                                                chmod 600 /tmp/jenkins_git_key

                                                VAULT_FILE="/home/jenkins-build/.vault_pass.txt"
                                                TMP_FILE="\$(mktemp /tmp/vault.XXXXXX)"
                                                umask 077
                                                printf "%s" "${VAULT_PASS}" > "\${TMP_FILE}"
                                                mv -f "\${TMP_FILE}" "\${VAULT_FILE}"
                                                chmod 600 "\${VAULT_FILE}"

                                                cd "$WORKSPACE/Jenkins-job/preprod-jenkins/jenkins-pipeline/build"
                                                bash scripts/prepare_env.sh "\${TARGET_FQDN}" "${WORK_DIR}" true \
                                                    git@github.com:ceph/ceph-build.git \
                                                    git@github.com:ceph/ceph-cm-ansible.git \
                                                    git@github.com:ceph/ceph-sepia-secrets.git

                                                bash scripts/ansible_runner.sh \
                                                    "\${TARGET_FQDN}" \
                                                    "${WORK_DIR}" \
                                                    "${VENV_PATH}" \
                                                    "${OS}" \
                                                    "${BUILDER_TOKEN}"
                                            """
                                        }

                                        // === Verification: Is node online? ===
                                        echo "[${n}] Verification: checking Jenkins connection"
                                        try {
                                            def nodeObj = Jenkins.instance.getNode(n)
                                            def comp = nodeObj?.toComputer()
                                            if (comp?.online) {
                                                echo "[${n}] SUCCESS: Builder is online & connected"
                                            } else {
                                                echo "[${n}] WARNING: Builder not connected yet after reimage"
                                                currentBuild.result = 'UNSTABLE'
                                            }
                                        } catch (vErr) {
                                            echo "[${n}] Verification error: ${vErr}"
                                            currentBuild.result = 'UNSTABLE'
                                        }

                                        echo "[${n}] Done."
                                    }
                                }
                            }
                        }
                    }

                    parallel branches

                    echo "Parallel execution complete."
                }
            }
        }
    }

    post {
        always {
            sh 'rm -f /home/jenkins-build/.vault_pass.txt || true'
            echo 'Build finished!'
        }
        success {
            echo 'Build succeeded for all target nodes.'
        }
        failure {
            echo 'Build failed for one or more nodes.'
        }
    }
}
